# ============================================================
# AI Food Recipe Suggestion - Environment Variables Template
# Sao chép file này thành .env và điền giá trị thật
# ============================================================

# ─── Database (SQL Server) ───────────────────────────────────
# Docker: DB_HOST=sqlserver | Local: DB_HOST=localhost hoặc tên instance
DB_HOST=localhost
DB_PORT=1433
DB_NAME=food_recipe_db
DB_USER=sa
DB_PASSWORD=your_strong_password_here

# ─── JWT ─────────────────────────────────────────────────────
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ─── Gemini AI ───────────────────────────────────────────────
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend ────────────────────────────────────────────────
# Docker: http://localhost/api | Local: /api
NEXT_PUBLIC_API_URL=/api

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
